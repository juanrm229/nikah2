# Salin file ini menjadi .env.local, lalu isi dari Supabase → Project Settings → API.
# .env.local sudah diabaikan git; JANGAN commit kunci asli.

# Aman terekspos ke browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RAHASIA. Menembus RLS. Server saja — jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi halaman petugas (/scan) dan panel moderasi (/admin).
ADMIN_PASSWORD=

# Alamat produksi, dipakai membentuk isi QR check-in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
